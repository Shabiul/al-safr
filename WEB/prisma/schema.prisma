datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StaffRole {
  SUPER_ADMIN
  STAFF
}

model StaffUser {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           StaffRole @default(STAFF)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Admin-managed catalogue — create/edit/publish/unpublish via the CRM.
model TourPackage {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  destination  String
  summary      String
  description  String
  durationDays Int
  priceUsd     Float
  images       String[]
  inclusions   String[]
  exclusions   String[]
  itinerary    Json
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum LeadType {
  QUOTE
  CONTACT
}

// Submissions from the "Get a Quote" and "Contact" forms on the WEB app.
model Lead {
  id          String   @id @default(cuid())
  type        LeadType
  name        String
  email       String?
  phone       String?
  service     String?
  destination String?
  message     String?
  createdAt   DateTime @default(now())
}

// One row per priced service (flight/hotel/cab) — a percentage markup the
// WEB app adds on top of the live supplier price before showing it to
// customers. Edited from the CRM; read by WEB at search time.
model MarkupSetting {
  service    String   @id // "flights" | "hotels" | "cabs"
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

// Management only for now — there's no checkout yet (payment gateway is
// deferred) for a code to actually be redeemed against.
model PromoCode {
  id            String            @id @default(cuid())
  code          String            @unique
  discountType  PromoDiscountType
  discountValue Float
  validFrom     DateTime?
  validUntil    DateTime?
  usageLimit    Int?
  timesUsed     Int               @default(0)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}
