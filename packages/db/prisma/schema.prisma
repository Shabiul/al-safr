datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StaffRole {
  SUPER_ADMIN
  STAFF
}

model StaffUser {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           StaffRole @default(STAFF)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
